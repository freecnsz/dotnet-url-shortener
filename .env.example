# Copy to .env and fill in. .env is never committed or sent to the Docker build context.

# PostgreSQL
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=urlshortener

# Seq admin password for the first run
SEQ_PASSWORD=change-me

# Public base URL of short links: absolute http(s), no path or query
BASE_URL=https://your-domain.example.com

# Abuse contact shown in the site footer; leave empty to hide it
CONTACT_EMAIL=

# Read the CF-IPCountry header; enable only when traffic really comes through Cloudflare
TRUST_CLOUDFLARE_HEADERS=false
