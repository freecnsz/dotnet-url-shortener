{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq:5341" } }
    ]
  },

  "ShortUrlOptions": {
    "BaseUrl": "https://vds.freecnsz.com"
  },

  "UrlCacheOptions": {
    "Ttl": "00:05:00"
  },

  "ClickTracking": {
    "TrustCloudflareHeaders": false
  },

  "ShortUrlPolicy": {
    "DefaultLifetime": "14.00:00:00",
    "StatsRetentionAfterExpiry": "6.00:00:00"
  }
}
